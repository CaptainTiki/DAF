[gd_scene format=3]

[ext_resource type="Script" path="res://ui/hud.gd" id="1_hud"]

[sub_resource type="Theme" id="theme_compact"]
default_font_size = 12

[node name="Hud" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = SubResource("theme_compact")
script = ExtResource("1_hud")

[node name="Bar" type="HBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 4.0
offset_top = -30.0
offset_right = -4.0
offset_bottom = -4.0
grow_horizontal = 2
grow_vertical = 0
mouse_filter = 2

[node name="DigButton" type="Button" parent="Bar"]
layout_mode = 2
tooltip_text = "Drag to mark tiles for digging. Right-drag or Shift-drag to unmark."
toggle_mode = true
text = "Dig"

[node name="StockpileButton" type="Button" parent="Bar"]
layout_mode = 2
tooltip_text = "Drag along a floor to mark storage. Right-drag or Shift-drag to unmark."
toggle_mode = true
text = "Stockpile"

[node name="StairsButton" type="Button" parent="Bar"]
layout_mode = 2
tooltip_text = "Drag diagonally to plan stairs. They can run through rock and floors. Right-drag or Shift-drag cancels a plan."
toggle_mode = true
text = "Stairs"

[node name="RequestsButton" type="Button" parent="Bar"]
layout_mode = 2
toggle_mode = true
text = "Requests"

[node name="DebugButton" type="Button" parent="Bar"]
layout_mode = 2
toggle_mode = true
text = "Debug"

[node name="Totals" type="Label" parent="Bar"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 5
text = "Stored: nothing yet"
clip_text = true

[node name="LayerUpButton" type="Button" parent="Bar"]
layout_mode = 2
tooltip_text = "Show the layer above"
text = "Up"

[node name="LayerLabel" type="Label" parent="Bar"]
