[node name="LayerDownButton" type="Button" parent="Bar"]
layout_mode = 2
tooltip_text = "Show the layer below"
text = "Down"

[node name="StripButton" type="Button" parent="Bar"]
layout_mode = 2
tooltip_text = "Dock as a strip along the bottom of the screen"
text = "Strip"

[node name="FullButton" type="Button" parent="Bar"]
layout_mode = 2
tooltip_text = "Full screen, free pan and zoom"
text = "Full"

[node name="CornerButton" type="Button" parent="Bar"]
layout_mode = 2
tooltip_text = "Small window in the corner of the screen"
