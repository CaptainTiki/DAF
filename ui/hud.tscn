[node name="DigButton" type="Button" parent="Bar"]
layout_mode = 2
tooltip_text = "Drag to mark tiles for digging. Right-drag or Shift-drag to unmark."
toggle_mode = true
text = "Dig"

[node name="StockpileButton" type="Button" parent="Bar"]
layout_mode = 2
tooltip_text = "Drag along a floor to mark storage. Right-drag or Shift-drag to unmark."
toggle_mode = true
text = "Stockpile"

[node name="BuildButton" type="Button" parent="Bar"]
layout_mode = 2
tooltip_text = "Build stairs and floors, or remove them."
toggle_mode = true
text = "Build"

[node name="RoomButton" type="Button" parent="Bar"]
layout_mode = 2
tooltip_text = "Plan a room. Drag over rock or dug space; dwarves dig it out and furnish it."
toggle_mode = true
